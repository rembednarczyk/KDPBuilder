  "age_groups": {
    "3-4": {
      "label": "Toddlers / przedszkole młodsze",
      "positive": [
        "extra thick bold outlines",
        "one single simple subject",
        "very large open areas to color",
        "big rounded friendly shapes",
        "no background",
        "minimal details",
        "oversized simple features"
