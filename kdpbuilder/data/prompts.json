    "4-8": {
      "label": "Szeroki zakres wieku (metadane 4-8)",
      "positive": [
        "bold clean outlines",
        "one main subject with a small scene around it",
        "a few background elements like water plants, bubbles and a small companion",
        "clear medium sized areas to color",
        "gentle decorative details",
        "balanced composition, not too sparse"
      ],
      "negative": ["overly empty page", "too few elements", "tiny intricate details", "photorealistic complexity"],
      "recommended_styles": ["kawaii", "cozy", "fantasy_costume", "habitat_scene", "seasonal"],
      "designs_default": 40
    },
    "5-6": {
      "label": "Przedszkole starsze / zerówka",
      "positive": [
        "thick bold outlines",
        "one main subject",
        "a few simple background elements like bubbles or water plants",
        "large clear areas to color",
        "gentle simple details",
        "uncluttered composition"
      ],
      "negative": ["dense patterns", "tiny intricate details", "crowded scene", "thin fragile lines"],
      "recommended_styles": ["kawaii", "cozy", "fantasy_costume", "seasonal", "habitat_scene"],
      "designs_default": 40
    },
    "6-7": {
      "label": "Wczesnoszkolne",
      "positive": [
        "bold clean outlines with some finer accents",
        "a small scene or habitat around the subject",
        "one or two companion elements",
        "simple decorative patterns",
        "more areas to color but still uncluttered",
        "balanced composition"
      ],
      "negative": ["overwhelming detail", "very thin lines", "photorealistic complexity"],
      "recommended_styles": ["kawaii", "cozy", "habitat_scene", "realistic_simple", "patterned", "fantasy_costume", "seasonal"],
      "designs_default": 40
    }
  },

  "styles": {
    "kawaii": {
      "label": "Kawaii / cute",
      "positive": ["kawaii style", "big sparkling eyes", "tiny hands", "soft happy smile", "chubby rounded body", "adorable", "chibi proportions"],
      "note": "Core seller. Theme-neutral so it works for any subject, not only axolotls."
    },
    "cozy": {
      "label": "Cozy / lifestyle",
      "positive": ["cozy scene", "soft hoodie", "holding a warm mug", "sitting on a cushion", "wrapped in a blanket", "relaxed and content"],
      "note": "Rides the strong cozy trend. Best for 5-6 and 6-7."
    },
    "fantasy_costume": {
      "label": "Fantasy / costume",
      "positive": ["whimsical costume", "tiny crown", "fairy wings", "little cape", "wizard hat", "magical accessory", "playful and imaginative"],
      "note": "Costumes and props add variety across a book."
    },
    "seasonal": {
      "label": "Seasonal / holiday",
      "positive": ["seasonal holiday theme", "festive accessory", "party mood"],
      "seasons": {
        "christmas": ["santa hat", "scarf", "small gift", "snowflakes"],
        "halloween": ["small pumpkin", "friendly ghost", "witch hat"],
        "easter": ["decorated egg", "bunny ears", "spring flowers"],
        "birthday": ["party hat", "balloon", "small cake", "confetti"],
        "valentine": ["small heart", "love theme", "cute bow"]
      },
      "note": "Seasonal books are a reliable secondary angle. Pass --season to pick."
    },
    "habitat_scene": {
      "label": "Habitat / underwater scene",
      "positive": ["underwater habitat", "water plants", "rising bubbles", "smooth rocks", "aquatic scene", "gentle waves"],
      "note": "Richer scenes for older kids. Keep areas large for 5-6."
    },
    "realistic_simple": {
      "label": "Simple realistic / educational",
      "positive": ["natural axolotl shape", "simple accurate anatomy", "gentle realistic proportions", "clear educational illustration"],
      "note": "Pairs well with fun-facts books for 6-7."
    },
    "patterned": {
      "label": "Patterned / decorative",
      "positive": ["simple decorative patterns on the body", "gentle mandala-like accents", "symmetrical shapes", "light ornamentation"],
      "note": "Adds coloring interest for 6-7 without clutter."
    }
  },

